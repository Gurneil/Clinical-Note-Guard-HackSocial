# Copy this file to .env (same directory) and fill in whichever keys you
# have. .env is gitignored - it is never committed. See README.md for
# where to get each key. Only Gemini is required to run anything at all;
# Groq and Featherless are optional automatic-failover tiers - if their
# keys aren't set, they're skipped (with a loud warning), not an error.

GEMINI_API_KEY=
GROQ_API_KEY=

# Either name works - FEATHERLESS_AI_API_KEY is checked first.
FEATHERLESS_AI_API_KEY=
FEATHERLESS_API_KEY=
